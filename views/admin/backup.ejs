<%- include('../partials/header') %>

<div class="grid" style="max-width:860px;">

  <!-- Quick actions -->
  <div class="card">
    <h3>Database Backup</h3>
    <p class="muted" style="margin-bottom:20px;">
      The database contains all tickets, projects, users, and settings.
      Download a copy or save a timestamped snapshot to the server.
    </p>

    <div style="display:flex;gap:12px;flex-wrap:wrap;">
      <!-- Instant download of live DB -->
      <a href="/admin/backup/download" class="btn btn-primary">
        &#8659; Download Live Database
      </a>

      <!-- Save snapshot to server -->
      <form method="POST" action="/admin/backup/create">
        <button type="submit" class="btn btn-secondary">
          &#128190; Save Backup to Server
        </button>
      </form>
    </div>

    <div style="margin-top:16px;padding:12px 14px;background:#f5f5f5;border-radius:6px;font-size:.85rem;color:var(--text-muted);">
      <strong>Restore tip:</strong> To restore, stop the server, replace
      <code>data/app.db</code> with your backup file, then restart the server.
    </div>
  </div>

  <!-- Saved backups list -->
  <div class="card">
    <div class="card-header">
      <h3>Saved Backups</h3>
      <span class="badge badge-muted"><%= backups.length %></span>
    </div>

    <% if (backups.length === 0) { %>
      <p class="muted">No saved backups yet. Click "Save Backup to Server" to create one.</p>
    <% } else { %>
      <div class="table-wrap">
        <table class="data-table">
          <thead>
            <tr>
              <th>Filename</th>
              <th>Size</th>
              <th>Created</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% backups.forEach(b => { %>
              <tr>
                <td style="font-family:monospace;font-size:.85rem;"><%= b.name %></td>
                <td class="muted small"><%= fmtBytes(b.size) %></td>
                <td class="muted small"><%= helpers.fmtDate(b.created) %></td>
                <td style="display:flex;gap:8px;justify-content:flex-end;">
                  <a href="/admin/backup/<%= encodeURIComponent(b.name) %>"
                     class="btn btn-secondary btn-small">&#8659; Download</a>
                  <form method="POST"
                        action="/admin/backup/<%= encodeURIComponent(b.name) %>/delete"
                        onsubmit="return confirm('Delete this backup?');">
                    <button type="submit" class="btn btn-danger btn-small">Delete</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <p class="muted x-small" style="margin-top:8px;">
        Server keeps the 20 most recent backups automatically.
      </p>
    <% } %>
  </div>

</div>

<%- include('../partials/footer') %>
