<%- include('../partials/header') %>

<div class="card narrow-card">
  <% if (!upToDate && !error && latestSHA) { %>
    <div style="background:#e8f5e9;border-left:4px solid #4caf50;padding:14px 16px;border-radius:4px;margin-bottom:20px;">
      <strong style="color:#2e7d32;">Update Available</strong>
      <div style="margin-top:4px;color:#388e3c;font-size:.92rem;">
        Latest: <code><%= latestSHA %></code>
        <% if (latestMsg) { %> — <em><%= latestMsg %></em><% } %>
      </div>
    </div>
  <% } %>

  <% if (upToDate) { %>
    <div style="background:#e3f2fd;border-left:4px solid #1976d2;padding:14px 16px;border-radius:4px;margin-bottom:20px;">
      <strong style="color:#1565c0;">System is up to date</strong>
      <div style="margin-top:4px;color:#1976d2;font-size:.92rem;">
        Version <code><%= currentSHA %></code> — last updated <%= currentDate %>
      </div>
    </div>
  <% } %>

  <% if (error) { %>
    <div style="background:#fff3e0;border-left:4px solid #f57c00;padding:14px 16px;border-radius:4px;margin-bottom:20px;">
      <strong style="color:#e65100;">Could not check for updates</strong>
      <div style="margin-top:4px;color:#ef6c00;font-size:.92rem;"><%= error %></div>
    </div>
  <% } %>

  <table class="table" style="margin-bottom:24px;">
    <tbody>
      <tr>
        <td style="width:180px;color:var(--text-muted);">Installed version</td>
        <td><code><%= currentSHA %></code>
          <% if (currentDate !== 'never') { %>
            <span style="color:var(--text-muted);font-size:.85rem;margin-left:8px;">updated <%= currentDate %></span>
          <% } %>
        </td>
      </tr>
      <tr>
        <td style="color:var(--text-muted);">Latest on GitHub</td>
        <td>
          <% if (latestSHA) { %>
            <code><%= latestSHA %></code>
            <% if (upToDate) { %>
              <span style="color:#388e3c;margin-left:6px;font-size:.85rem;">&#10003; Up to date</span>
            <% } else { %>
              <span style="color:#f57c00;margin-left:6px;font-size:.85rem;">&#9650; New version available</span>
            <% } %>
          <% } else { %>
            <span style="color:var(--text-muted);">—</span>
          <% } %>
        </td>
      </tr>
    </tbody>
  </table>

  <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
    <% if (!upToDate && !error && latestSHA) { %>
      <form method="POST" action="/admin/update/apply" id="updateForm">
        <button type="submit" class="btn btn-primary" onclick="return confirmUpdate(this)">
          &#8595; Download &amp; Apply Update (Automatic)
        </button>
      </form>
    <% } %>
    <form method="GET" action="/admin/update">
      <button type="submit" class="btn btn-secondary">&#8635; Check Again</button>
    </form>
  </div>

  <p id="downloadStatus" class="muted small" style="margin-top:12px;"></p>

  <div style="margin-top:12px;font-size:.85rem;color:var(--text-muted);">
    Automatic update needs this PC's Node.js process to reach GitHub directly. On some
    networks that's blocked even though a browser can reach GitHub fine — if the button
    above fails or hangs, use Manual Update below instead.
  </div>

  <div style="margin-top:28px;padding-top:20px;border-top:1px solid var(--border);">
    <h3 style="margin:0 0 4px;">Manual Update</h3>
    <p class="muted small" style="margin:0 0 16px;">
      Downloads through your browser instead of the server — use this if Automatic Update
      above doesn't work on this network.
    </p>

    <div style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
      <a href="/admin/update/download-link" target="_blank" class="btn btn-secondary" id="manualDownloadBtn">
        1. Download Update ZIP
      </a>
      <form method="POST" action="/admin/update/apply-local" id="applyLocalForm">
        <button type="submit" class="btn btn-primary" onclick="return confirmApplyLocal(this)">
          2. Apply Downloaded Update
        </button>
      </form>
    </div>

    <div style="margin-top:12px;font-size:.85rem;color:var(--text-muted);">
      Step 1 opens a normal browser download (saves to your Downloads folder) — wait for it
      to finish. Step 2 reads that file directly off this PC's disk, so it doesn't need any
      network access itself. The server restarts automatically afterward.
    </div>
  </div>

  <div style="margin-top:24px;padding-top:16px;border-top:1px solid var(--border);font-size:.85rem;color:var(--text-muted);">
    <strong>What happens when you update?</strong><br>
    Either path replaces the application files with the latest code from GitHub and
    restarts the server automatically. The database and uploaded files are never touched.
  </div>
</div>

<script>
// Disabling a submit button *synchronously* inside its own click handler,
// before the handler returns, can make the browser silently skip the form's
// default submit action — the button is already disabled by the time the
// browser gets to it. Deferring the disable with setTimeout(...,0) pushes it
// to the next tick, after the browser has already committed to submitting.
function confirmUpdate(btn) {
  if (!confirm('Apply the update now?\n\nThe server will restart automatically. This takes ~20 seconds.')) return false;

  setTimeout(() => {
    btn.disabled = true;
    btn.textContent = 'Downloading...';

    const statusEl = document.getElementById('downloadStatus');
    const startedAt = Date.now();
    const iv = setInterval(() => {
      const secs = Math.round((Date.now() - startedAt) / 1000);
      statusEl.textContent = secs < 20
        ? `Downloading update from GitHub… (${secs}s)`
        : `Still working… (${secs}s) — if this passes a minute, the connection to GitHub is likely blocked; try Manual Update below instead.`;
    }, 1000);
    window.addEventListener('beforeunload', () => clearInterval(iv));
  }, 0);

  return true;
}

function confirmApplyLocal(btn) {
  if (!confirm('Apply the downloaded update now?\n\nMake sure step 1\'s download finished first. The server will restart automatically.')) return false;

  setTimeout(() => {
    btn.disabled = true;
    btn.textContent = 'Applying...';
  }, 0);

  return true;
}
</script>

<%- include('../partials/footer') %>
