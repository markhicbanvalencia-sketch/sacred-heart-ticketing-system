<%- include('../partials/header') %>

<div class="grid two-col">
  <div class="card">
    <h3>Add department</h3>
    <form method="POST" action="/admin/departments" class="form">
      <label>Name <span class="req">*</span><input type="text" name="name" required></label>
      <label>Description<input type="text" name="description"></label>
      <button type="submit" class="btn btn-primary">Add</button>
    </form>
  </div>
  <div class="card">
    <h3>All departments (<%= departments.length %>)</h3>
    <table class="data-table">
      <thead><tr><th>Name</th><th>Description</th><th>Users</th><th></th></tr></thead>
      <tbody>
        <% departments.forEach(d => { %>
          <tr>
            <td><strong><%= d.name %></strong></td>
            <td class="muted small"><%= d.description || '—' %></td>
            <td><%= d.user_count %></td>
            <td>
              <details>
                <summary class="btn btn-link small">Edit</summary>
                <form method="POST" action="/admin/departments/<%= d.id %>/update" class="form compact mt8">
                  <input type="text" name="name" value="<%= d.name %>" required>
                  <input type="text" name="description" value="<%= d.description || '' %>">
                  <button type="submit" class="btn btn-primary btn-small">Save</button>
                </form>
                <form method="POST" action="/admin/departments/<%= d.id %>/delete" class="mt8" onsubmit="return confirm('Delete this department?');">
                  <button type="submit" class="btn btn-danger btn-small">Delete</button>
                </form>
              </details>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>
