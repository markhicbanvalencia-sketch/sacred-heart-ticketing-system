<%
// Usage from any view:
//   <%- include('layouts/app', { content: { file: 'tickets/list', data: locals } }) %>
// This pattern lets each view stay declarative while sharing chrome (sidebar/topbar).
%><!DOCTYPE html>
<html lang="en">
<head>
<%- include('../partials/head') %>
</head>
<body class="app">
  <%- include('../partials/sidebar') %>
  <div class="main">
    <%- include('../partials/topbar') %>
    <main class="content">
      <%- include('../partials/flash') %>
      <%- contentHtml %>
    </main>
  </div>
</body>
</html>
